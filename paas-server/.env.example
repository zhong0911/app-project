port: 8080
# 执行层：docker = 真实容器，mock = 本地模拟（无 Docker 权限时使用），auto = 自动探测
PAAS_EXECUTOR=auto
# 真实 Docker 驱动连接方式：socket（本机）或 tcp（远程 Docker API，如 tcp://10.0.0.2:2375）
DOCKER_MODE=socket
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_HOST=
# 平台对外访问地址，用于生成应用访问链接（如 https://apps.example.com）
PAAS_PUBLIC_HOST=
# 为容器分配宿主端口的起始值
PAAS_PORT_RANGE_START=20000
# 会话有效期（小时）
PAAS_SESSION_HOURS=72
# 初始管理员账号（首次启动自动创建）
PAAS_ADMIN_USER=admin
PAAS_ADMIN_PASSWORD=admin123456

# ---- SSO（AntX Passport，OAuth2 授权码）----
# 在 SSO 控制台登记应用后填入；client_id 为空时 /sso/authorize 回退本地登录
SSO_ISSUER=https://passport.antx.cc
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_SCOPE=openid
# 显式指定回调地址（留空时按请求 Host 自动生成 {origin}/sso/callback）
SSO_REDIRECT_URI=
# 管理员 sub（默认 1）
SSO_ADMIN_UID=1
