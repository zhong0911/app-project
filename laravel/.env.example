# ============================================
# AntX Laravel 模板 - 环境变量示例
# 复制为 .env 后执行 php artisan key:generate
# ============================================

APP_NAME=laravel-template
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antx_template
DB_USERNAME=root
DB_PASSWORD=root

# ---- 会话（SSO token 存服务端会话；生产换 redis 驱动） ----
SESSION_DRIVER=file
SESSION_COOKIE_NAME=SESSION
SESSION_MAX_AGE=1800
SESSION_SECURE_COOKIE=false

# ---- 本地联调（无 SSO 时的 Basic 用户，生产置 false） ----
SECURITY_BASIC_ENABLED=true
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=admin123

# ---- CORS（允许携带会话 Cookie 的前端来源，逗号分隔，不能用 *） ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- SSO（AntX passport-sso） ----
SSO_ISSUER=https://passport.antx.cc
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_SCOPE=openid,profile,email,roles,permissions
SSO_REDIRECT_URI=http://localhost:8080/sso/callback
SSO_AUTHORIZATION_URI=https://passport.antx.cc/oauth2/authorize
SSO_TOKEN_URI=https://passport.antx.cc/oauth2/token
SSO_USERINFO_URI=https://passport.antx.cc/userinfo
SSO_JWKS_URI=https://passport.antx.cc/oauth2/jwks
SSO_REVOKE_URI=https://passport.antx.cc/oauth2/revoke
# 登录成功后的兜底地址（前端通过 /sso/authorize?redirect_uri=xxx 透传回跳页面时以它为准；这里供无回跳参数的接口调试用：/api/auth/me）
SSO_LOGIN_SUCCESS_URL=/api/auth/me
SSO_LOGOUT_URI=
SSO_ADMIN_UID=1

# ---- 图床 ----
# 存储磁盘：images-本地磁盘（storage/app/images）/ s3-MinIO 或云对象存储（需 composer require league/flysystem-aws-s3-v3）
IMAGE_DISK=images
# 图片直链域名（生产建议独立二级域名，留空则回落到 APP_URL）
IMAGE_DOMAIN=
# 公开访问路径前缀：/i/{uuid}
IMAGE_PREFIX=i
# 单图大小上限（字节），默认 10MB；同时需保证 PHP 的 upload_max_filesize / post_max_size 不小于该值
IMAGE_MAX_SIZE=10485760
# 是否累计访问次数（量大可关掉，改用 Nginx 日志统计）
IMAGE_COUNT_VISIT=true

# ---- 对象存储（IMAGE_DISK=s3 时生效） ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=antx-image
# AWS_ENDPOINT=http://127.0.0.1:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true
