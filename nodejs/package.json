{
  "name": "antx-nodejs-template",
  "version": "1.0.0",
  "description": "AntX Node.js(Express) 后端模板：统一响应 + 用户管理 + SSO 接入",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mysql2": "^3.11.5",
    "jose": "^5.9.6"
  }
}
