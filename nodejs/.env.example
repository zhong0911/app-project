# ============================================
# AntX Node.js 模板 - 环境变量示例（对标 springboot/.env）
# 复制为 .env 后加载（如 dotenv），或直接注入到进程环境
# ============================================

# ---- 服务器 ----
PORT=8080

# ---- OAuth2 客户端（SSO 授权码登录）----
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
# 授权服务器地址；端点留空时由它推导标准路径
SSO_ISSUER=http://localhost:9000
# 端点非标准时显式指定（可留空）
SSO_AUTHORIZATION_URI=
SSO_TOKEN_URI=
SSO_USERINFO_URI=
# 授权范围
SSO_SCOPE=openid,profile,email,roles,permissions
# 登录成功后的重定向地址（一般指向前端首页）
SSO_LOGIN_SUCCESS_URL=/
