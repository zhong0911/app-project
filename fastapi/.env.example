# ============================================
# AntX FastAPI 模板 - 环境变量示例（对标 springboot/.env）
# 复制为 .env 后加载（如：dotenv / export），或直接注入到进程环境
# ============================================

# ---- 服务器 ----
SERVER_PORT=8080

# ---- OAuth2 客户端（SSO 授权码登录）----
SSO_CLIENT_ID=app
SSO_CLIENT_SECRET=your-sso-client-secret
# 授权服务器地址（默认 AntX passport-sso，支持 /.well-known/openid-configuration 发现）；端点留空时由它推导标准路径
SSO_ISSUER=https://passport.antx.cc
# 端点非标准时显式指定（可留空）
SSO_AUTHORIZATION_URI=
SSO_TOKEN_URI=
SSO_USERINFO_URI=
# token 撤销端点（留空时由 SSO_ISSUER 推导标准路径 /oauth2/revoke；POST /api/auth/logout 退出时撤销会话中的 refresh_token）
SSO_REVOKE_URI=
# 授权范围
SSO_SCOPE=openid,profile,email,roles,permissions
# 登录成功后的重定向地址（一般指向前端首页）
SSO_LOGIN_SUCCESS_URL=/
# 单点退出地址（授权服务器登出端点；POST /api/auth/logout 返回给前端整页跳转，留空仅退出本应用）
SSO_LOGOUT_URI=
