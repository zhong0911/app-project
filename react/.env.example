# 复制为 .env.local 后按需覆盖（.env.local 不入库）

# 应用标题
VITE_APP_TITLE=图床

# 后端接口基础地址：
# - 开发：/api（走 vite 代理，见 vite.config.js 的 proxy）
# - 生产：https://your-domain.com/api
VITE_API_BASE_URL=/api

# 开发环境 vite 代理转发目标（真实后端地址）
VITE_PROXY_TARGET=http://localhost:8080

# 账号中心（SSO 用户中心）地址，登录后用户菜单「账号中心」跳转
VITE_ACCOUNT_CENTER_URL=https://passport.antx.cc
