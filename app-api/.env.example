# ============================================
# AntX Spring Boot 模板 - 环境变量配置示例
# 复制为 .env 后填写实际值（.env 已被 .gitignore 忽略，不会提交）
# ============================================

# ---- MySQL（统一一个 DB_URL，含主机/端口/库名/参数） ----
DB_URL=jdbc:mysql://your-db-host:3306/antx_template?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=your-username
DB_PASSWORD=your-password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- Mail（SMTP，如 QQ/163/Gmail；密码填授权码而非登录密码） ----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code

# ---- Spring Security（内存用户，仅本地联调） ----
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=change-me

# ---- OAuth2 接入 AntX passport-sso ----
# 客户端登录（授权码）：子应用在 SSO 控制台注册的 client-id / client-secret
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_ISSUER=http://localhost:9000
# 登录成功后重定向地址（生产子应用指向前端首页，如 https://tools.antx.cc；默认 /api/auth/me 返回 JSON 供调试）
SSO_LOGIN_SUCCESS_URL=https://tools.antx.cc

# ---- 服务器 ----
SERVER_PORT=8080
