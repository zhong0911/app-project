# ============================================
# AntX Spring Boot 模板 - 环境变量配置示例
# 复制为 .env 后填写实际值（.env 已被 .gitignore 忽略，不会提交）
# ============================================

# ---- MySQL（统一一个 DB_URL，含主机/端口/库名/参数） ----
DB_URL=jdbc:mysql://your-db-host:3306/antx_template?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=your-username
DB_PASSWORD=your-password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- Mail（SMTP，如 QQ/163/Gmail；密码填授权码而非登录密码） ----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code

# ---- Spring Security（内存用户，仅本地联调；生产 profile 会自动关闭） ----
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=change-me
# 生产如需保留 httpBasic 可显式设为 true（默认配置在 prod 为 false）
# SECURITY_BASIC_ENABLED=false

# ---- CORS（允许携带会话 Cookie 的前端来源，逗号分隔，不能使用 *） ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- OAuth2 接入 AntX passport-sso ----
# 客户端登录（授权码）：provider 注册名为 sso；client-id / client-secret 均为占位值，正式值在 SSO 控制台注册后替换
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_ISSUER=https://passport.antx.cc
# 登录成功后的兜底地址（优先用前端 /sso/authorize?redirect_uri=xxx 透传的回跳页；无回跳参数才落到这里，
# 默认 / 即站点首页；若配成其他绝对地址，其 origin 会自动加入回跳地址白名单）
SSO_LOGIN_SUCCESS_URL=/
# 管理员 SSO uid（access_token 的 sub）；默认 1，可改成实际管理员 uid
SSO_ADMIN_UID=1
# 单点退出地址（授权服务器登出端点；POST /api/auth/logout 返回给前端整页跳转，留空仅退出本应用）
SSO_LOGOUT_URI=
# token 撤销端点（默认 passport.antx.cc/oauth2/revoke；退出登录时后端撤销会话中的 refresh_token）
SSO_REVOKE_URI=https://passport.antx.cc/oauth2/revoke

# ---- 服务器 ----
SERVER_PORT=8080
