# ============================================================
# AntX 模板 Docker 编排 —— 环境变量示例
# 复制为 .env 后修改（.env 含密码，请勿提交到 git）
#   复制方法：cp .env.example .env   （Windows: copy .env.example .env）
# ============================================================

# ---- 应用名 / 项目前缀（决定容器名与卷名，每个新应用改这个即可） ----
COMPOSE_PROJECT_NAME=antx-app1

# ---- 对外端口 ----
WEB_PORT=80          # 前端入口（对外主端口，一般只开放这个）
API_PORT=8080        # 后端 API（可选暴露，供调试；日常由 nginx 同源反代）
MYSQL_PORT=3306      # MySQL（外部工具直连用；容器间走内网，无需开放）

# ---- MySQL ----
# 强烈建议改为强密码
MYSQL_ROOT_PASSWORD=change-me-strong-password
# 数据库名：需与 api/src/main/resources/sql/init.sql 里 USE 的库名一致
MYSQL_DATABASE=antx_template

# ---- 邮件 SMTP（可选；不填则邮件功能不可用） ----
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Security 内存用户（仅本地联调用，接入 SSO 后可不改） ----
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=admin123

# ---- SSO（passport-sso 授权码登录；不填则无法登录，可用 httpBasic 内存用户联调） ----
# 在 SSO 控制台注册本应用得到的 client-id / client-secret
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# SSO 地址：必须能被 api 容器访问（容器内不能是 localhost），如 https://sso.antx.cc
SSO_ISSUER=
# 登录成功后的重定向地址（一般指向前端地址，如 https://app1.antx.cc）
SSO_LOGIN_SUCCESS_URL=
# 如 SSO 端点非标准路径，可显式指定（否则留空，使用 SSO_ISSUER 下的标准路径）
SSO_AUTHORIZATION_URI=
SSO_TOKEN_URI=
SSO_USERINFO_URI=
SSO_JWKS_URI=
